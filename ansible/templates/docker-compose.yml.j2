# Generated by Ansible ({{ ansible_managed | default('roomsync playbook') }}) — edit
# ansible/templates/docker-compose.yml.j2 and re-run the playbook, don't edit this
# file directly, your changes will be overwritten on the next run.
#
# Deploys the real images GitHub Actions built and pushed to GHCR — no local build
# context anywhere in this file.

services:
  mongo:
    image: mongo:7
    container_name: roomsync-mongo
    ports:
      - "{{ mongo_port }}:27017"
    volumes:
      - mongo_data:/data/db
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping')"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s
    restart: unless-stopped

  python-service:
    image: {{ ghcr_python_image }}
    container_name: roomsync-python-service
    ports:
      - "{{ python_port }}:8000"
    env_file:
      - .env
    restart: unless-stopped

  backend:
    image: {{ ghcr_backend_image }}
    container_name: roomsync-backend
    ports:
      - "{{ backend_port }}:5000"
    env_file:
      - .env
    environment:
      PORT: 5000
      BACKEND_URL: http://backend:5000
    depends_on:
      mongo:
        condition: service_healthy
      python-service:
        condition: service_started
    restart: unless-stopped

  frontend:
    # NEXT_PUBLIC_API_URL/NEXT_PUBLIC_DEV_AUTH are baked into this image's client JS
    # bundle at CI build time (see frontend/Dockerfile) — they cannot be changed here,
    # setting them via `environment:` would be silently ignored. This image was built
    # with NEXT_PUBLIC_API_URL=http://localhost:5000, which does NOT match this
    # deployment's backend_port ({{ backend_port }}) — see docs/ansible-deployment.md
    # for exactly what that does and doesn't break.
    image: {{ ghcr_frontend_image }}
    container_name: roomsync-frontend
    ports:
      - "{{ frontend_port }}:3000"
    environment:
      BACKEND_URL: http://backend:5000
      NEXTAUTH_URL: http://localhost:{{ frontend_port }}
    env_file:
      - .env
    depends_on:
      backend:
        condition: service_started
    restart: unless-stopped

volumes:
  mongo_data:
    name: roomsync_ansible_mongo_data
