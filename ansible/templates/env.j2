# Generated by Ansible — placeholder secrets, safe to check the rendered file into a
# screenshot/log but rotate both before any real use.
NEXTAUTH_SECRET={{ nextauth_secret }}
# Shared between backend and python-service (see backend/main.py's
# require_internal_service_key middleware) - python-service has no auth of its own
# otherwise, which matters here specifically since this deployment publishes it on a
# host port rather than keeping it ClusterIP-only like the K8s shape does.
INTERNAL_SERVICE_KEY={{ internal_service_key }}

# Service-name DNS, not localhost — these run on the deployed compose network, not
# the host network, so the internal port (5000/8000) is always right regardless of
# what host port backend_port/python_port publish to.
MONGO_URI=mongodb://mongo:27017/hostel_allocator
PYTHON_SERVICE_URL=http://python-service:8000
DEV_AUTH=true
USE_REST_ALLOCATION=true
# The frontend's real browser-facing origin on this deployment's own distinct port.
ALLOWED_ORIGINS=http://localhost:{{ frontend_port }}
