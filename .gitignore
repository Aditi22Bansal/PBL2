# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist
out/

# python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook
.ipynb_checkpoints

# pytest
.pytest_cache/

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# (frontend/.env.local and similar are also caught by the broader *.local rule
# below, but listed explicitly here too so this exclusion doesn't silently
# depend on that unrelated-looking catch-all pattern.)
.vs/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js
.next/
frontend/.next/

# TypeScript incremental build cache
*.tsbuildinfo

# Vite
dist-ssr/
*.local

# Editor directories and files
.idea
.vscode
*.sublime-workspace
*.sublime-project

# OS generated files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Local DB backup dumps (real student data - never committed)
backend/scripts/backups/

# User-specific & Data
*.csv
output_absolute_final.csv
Roommate Preferences.csv
allocations.csv
profiles.csv

# Compiled assets
frontend/dist/
backend/node_modules/
frontend/node_modules/
backend/__pycache__/
backend/ml_engine/__pycache__/

*.png
# ...except the K8s deployment demo screenshots - those are real
# documentation, embedded directly in docs/k8s-deployment.md.
!docs/k8s-screenshots/*.png
# ...and likewise the Ansible deployment demo screenshots.
!docs/ansible-screenshots/*.png
# ...and likewise the monitoring/Grafana dashboard demo screenshot.
!docs/monitoring-screenshots/*.png
backend/data/*.csv

# Docker - local-only overrides (may carry machine-specific ports/secrets)
docker-compose.override.yml
docker-compose.override.yaml

# Ansible demo SSH keypair - generated locally by ansible/setup.sh, real key
# material, never committed. The directory itself (with a .gitkeep) still is.
ansible/keys/*
!ansible/keys/.gitkeep
