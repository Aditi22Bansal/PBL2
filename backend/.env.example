# Copy this file to backend/.env and fill in real values for your environment.
# All placeholder values below are fake - do not reuse them anywhere real.

# MongoDB connection string. Local dev default matches a local Mongo install;
# inside Docker Compose this is set to mongodb://mongo:27017/hostel_allocator instead.
MONGO_URI=mongodb://127.0.0.1:27017/hostel_allocator

# Port the Express/Socket.IO server listens on.
PORT=5000

# Base URL of the Python FastAPI allocation microservice (backend/main.py).
# Used by services/allocationService.js when USE_REST_ALLOCATION=true.
# Inside Docker Compose this is http://python-service:8000 (service name, not localhost).
PYTHON_SERVICE_URL=http://localhost:8000

# Feature flag: true = call the Python service over REST (POST /allocate/v2, the live
# path); false/unset = fall back to the legacy child_process.spawn(executor.py) path.
USE_REST_ALLOCATION=true

# Lets the frontend's dev-login flow skip requiring a real password upstream. Does
# NOT relax the real per-organization email-domain check in routes/auth.js's
# sync-user endpoint - a dev-auth login still has to belong to a real, registered
# organization's domain, same as production. Pairs with frontend/.env.local's
# NEXT_PUBLIC_DEV_AUTH. Leave unset/false in production.
DEV_AUTH=true

# Comma-separated allowlist of origins the Express CORS middleware accepts (also used
# for the Socket.IO handshake). Empty/unset denies all cross-origin requests.
# Docker Compose sets this to http://localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret the Python allocation service (backend/main.py) requires on every
# route except /health and /metrics, sent as the X-Internal-Service-Key header by
# services/allocationService.js. Must match INTERNAL_SERVICE_KEY in the Python
# service's own environment (see backend/Dockerfile.python / docker-compose.yml).
INTERNAL_SERVICE_KEY=change-me-to-a-real-shared-secret
