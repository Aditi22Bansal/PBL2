# Copy this file to backend/.env and fill in real values for your environment.
# All placeholder values below are fake - do not reuse them anywhere real.

# MongoDB connection string. Local dev default matches a local Mongo install;
# inside Docker Compose this is set to mongodb://mongo:27017/hostel_allocator instead.
MONGO_URI=mongodb://127.0.0.1:27017/hostel_allocator

# Port the Express/Socket.IO server listens on.
PORT=5000

# Base URL of the Python FastAPI allocation microservice (backend/main.py).
# Used by services/allocationService.js when USE_REST_ALLOCATION=true.
# Inside Docker Compose this is http://python-service:8000 (service name, not localhost).
PYTHON_SERVICE_URL=http://localhost:8000

# Feature flag: true = call the Python service over REST (POST /allocate/v2, the live
# path); false/unset = fall back to the legacy child_process.spawn(executor.py) path.
USE_REST_ALLOCATION=true

# When true, relaxes the @sitpune.edu.in email-domain check in routes/auth.js's
# sync-user endpoint, and is what frontend/.env.local's NEXT_PUBLIC_DEV_AUTH pairs with
# to enable the no-password dev login flow end to end. Leave unset/false in production.
DEV_AUTH=true
