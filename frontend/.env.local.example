# Copy this file to frontend/.env.local and fill in real values for your environment.
# All placeholder values below are fake - do not reuse them anywhere real.

# --- Dev-auth mode (no real login/password needed) ---

# When true, login/page.tsx shows the role-select + name/email dev login form instead
# of real Google OAuth, and the NextAuth route treats "dev-login" as the active
# credentials provider. NEXT_PUBLIC_ vars are baked into the client bundle at build
# time - pair with backend/.env's DEV_AUTH=true for the full flow to work end to end.
NEXT_PUBLIC_DEV_AUTH=true

# --- NextAuth (required in all modes) ---

# Secret NextAuth uses to encrypt session tokens/cookies. Generate a real one with
# `openssl rand -base64 32` before deploying anywhere real.
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret

# Canonical URL of this frontend app; NextAuth uses it to build callback/redirect URLs.
# Read implicitly by the next-auth library itself, not by this app's own code directly.
NEXTAUTH_URL=http://localhost:3000

# --- Backend connectivity ---

# Base URL of the Node/Express backend, as reached from the BROWSER (client-side code
# in lib/api.ts). Must stay host-reachable - inlined into the client bundle at build
# time, so "http://backend:5000" (the Docker service name) would NOT resolve here.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Base URL of the same backend, as reached from THIS APP'S OWN SERVER-SIDE code
# (NextAuth's signIn callback, the /api/student/profile proxy route) - runs inside the
# Next.js server process, so inside Docker Compose this correctly uses the service name:
# http://backend:5000. Outside Docker, same as NEXT_PUBLIC_API_URL above.
BACKEND_URL=http://localhost:5000

# --- Production Google OAuth (only used when NEXT_PUBLIC_DEV_AUTH is not "true") ---

# Google OAuth credentials for the production sign-in flow. Domain/tenant membership
# is gated by the real per-organization check in the signIn callback (backend's
# Organization.allowedEmailDomains lookup via sync-user) - not a hardcoded domain.
# Not needed in dev-auth mode.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Optional. Password for the "Demo Network Bypass" credentials provider (any email
# belonging to a real registered organization's domain + this password, no Google
# OAuth needed). If unset or empty, that provider is effectively disabled - the
# authorize() check requires a non-empty match, so an empty env var can never match
# an empty submitted password.
DEMO_BYPASS_PASSWORD=your-demo-password-here

# --- Unused (dead code - see lib/supabase.ts, not imported anywhere else in the app) ---

# Present because lib/supabase.ts reads them and falls back to mock values if unset.
# Safe to leave unset unless/until Supabase is actually wired into a feature.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
